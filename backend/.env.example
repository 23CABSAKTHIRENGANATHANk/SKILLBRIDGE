# SkillBridge Backend Environment Variables (Example Template)
# Copy to backend/.env and replace placeholders with your actual secure credentials

# PostgreSQL / Neon Database Connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=skillbridge
DB_USER=skillbridge_app
DB_PASS=REPLACE_WITH_STRONG_DB_PASSWORD
DB_SSLMODE=require

# JWT Authentication Secret (Minimum 32 random characters)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY

# Application Runtime Configuration
APP_ENV=development
API_PORT=8000

# Public frontend origin used by the backend CORS policy
FRONTEND_URL=http://localhost:8080

# OpenStreetMap Nominatim identification and upload limit
NOMINATIM_USER_AGENT=SkillBridge/1.0 contact@example.com
UPLOAD_MAX_SIZE=5242880

# AI Features — Google Gemini API
# Get your free key at: https://aistudio.google.com/app/apikey
# If left empty, AI features gracefully fall back to deterministic responses.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
