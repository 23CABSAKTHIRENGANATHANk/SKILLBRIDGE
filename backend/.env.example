# SkillBridge Backend Environment Variables (Example Template)
# Copy to backend/.env and replace placeholders with your actual secure credentials

# PostgreSQL / Neon Database Connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=skillbridge
DB_USER=skillbridge_app
DB_PASS=REPLACE_WITH_STRONG_DB_PASSWORD
DB_SSLMODE=require

# JWT Authentication Secret (Minimum 32 random characters)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY

# Application Runtime Configuration
APP_ENV=development
API_PORT=8000
